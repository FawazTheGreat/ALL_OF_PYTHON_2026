def verify(proposed_price, budget, customer_items, customer_item_df, barter_chance, customer_name, trade_success_count, trade_count, trade_fail_count):
      increase = 0
      trade_final = 0
      transaction_status = 'Nil'
      customer_item_price2 = 0
      if (proposed_price >= budget):
        customer_item_trade = random.choice(customer_items)
        customer_item_price = customer_item_df.loc[customer_item_trade, 'cust_item_cost'] # Corrected access
        typewrite(f'\n{customer_name} wants to trade {customer_item_trade} with you')

        if(proposed_price >= budget + customer_item_price):
          barter_choice = random.random()

          if barter_choice <= barter_chance:
            customer_item_trade2 = random.choice(customer_items)
            customer_item_price2 = customer_item_df.loc[customer_item_trade2, 'cust_item_cost'] # Corrected access
            typewrite(f'\n{customer_name} also wants to trade {customer_item_trade2} with you')

          if(proposed_price <= budget): #or proposed_price <= budget + customer_item_price or proposed_price <= budget + customer_item_price + customer_item_price2):
              trade_final = input("Do you accept?? (y/n)").lower()
          if(proposed_price <= budget + customer_item_price):
            trade_final = input("Do you accept?? (y/n)").lower()
          if(proposed_price <= budget + customer_item_price + customer_item_price2):
            trade_final = input("Do you accept?? (y/n)").lower()



          if(trade_final == "y"):
              typewrite("Trade done successfully!")
              transaction_status = 'Sold'
              trade_success_count += 1
              trade_count += 1
                # money += base_cost # money is global

          elif(trade_final == "n"):
            typewrite("No deal")
            transaction_status = "Not Sold"
            trade_fail_count += 1
            trade_count += 1



          elif(barter_choice > barter_chance):
            increase = input(f"This customer wants to negotiate and make the price {budget}, do you accept or ask for more (y/n)")

            if(increase == "y"):
              typewrite("Trade done successfully!")
              transaction_status = 'Sold'
              trade_success_count += 1
              trade_count += 1
                # money += base_cost # money is global

            elif(increase == "n"):
              typewrite("You ask for an increase")


      return barter_chance, transaction_status


